# Copy this file to:
# crates/loonfs-objectstore/tests/provider-conformance.env.local
#
# Then load it into your shell before running the ignored real-provider
# conformance tests and ignored server direct-put real-provider tests. The test
# harness reads process environment only.

# AWS S3
LOON_TEST_S3_BUCKET=example-loonfs-conformance-bucket
LOON_TEST_S3_REGION=us-east-1
LOON_TEST_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
LOON_TEST_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Optional for AWS S3. If set, either bucket-specific or bucket-less regional
# endpoints are accepted.
LOON_TEST_S3_ENDPOINT=https://example-loonfs-conformance-bucket.s3.us-east-1.amazonaws.com
LOON_TEST_S3_SESSION_TOKEN=example-session-token-for-temporary-creds
LOON_TEST_S3_PREFIX=conformance/aws-s3/manual

# Cloudflare R2
LOON_TEST_R2_BUCKET=example-loonfs-r2-bucket
LOON_TEST_R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
LOON_TEST_R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
LOON_TEST_R2_ACCESS_KEY_ID=example-r2-access-key-id
LOON_TEST_R2_SECRET_ACCESS_KEY=example-r2-secret-access-key-not-real
LOON_TEST_R2_PREFIX=conformance/r2/manual

# GCP GCS 
LOON_TEST_GCS_BUCKET=example-loonfs-gcs-bucket
LOON_TEST_GCS_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
LOON_TEST_GCS_PREFIX=conformance/gcp-gcs/manual

# Azure Blob Storage
LOON_TEST_ABS_ACCOUNT_NAME=examplestorageaccount
LOON_TEST_ABS_CONTAINER_NAME=example-loonfs-container
LOON_TEST_ABS_ACCESS_KEY=example-azure-account-access-key
LOON_TEST_ABS_ENDPOINT=https://examplestorageaccount.blob.core.windows.net
LOON_TEST_ABS_PREFIX=conformance/azure-abs/manual
