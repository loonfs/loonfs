{
  "version": 1,
  "name": "pagination",
  "intent": "Pins cursor pagination completeness, uniqueness, exhaustion, and resumption from a cursor saved during the first walk.",
  "family": "pagination",
  "operations": [
    "create_namespace",
    "create_directory container",
    "create_directory entries",
    "list_path_entries pages to exhaustion",
    "list_path_entries from saved cursor to exhaustion"
  ],
  "request": {
    "namespace_id": "conf-pagination",
    "directory": "/entries",
    "actor": {
      "kind": "service",
      "id": "conformance-pagination"
    },
    "entry_names": [
      "entry-00",
      "entry-01",
      "entry-02",
      "entry-03",
      "entry-04",
      "entry-05",
      "entry-06",
      "entry-07",
      "entry-08",
      "entry-09"
    ],
    "page_size": 3,
    "resume_after_page": 2
  },
  "expected": {
    "entry_count": 10,
    "minimum_page_count": 4,
    "head_seq": 11,
    "no_entry_missed": true,
    "no_entry_repeated": true,
    "next_cursor_absent_at_exhaustion": true,
    "resumed_walk_matches_saved_suffix": true
  }
}
