{
  "name": "proxy",
  "intent": "A proxy maps namespace aliases, adds server credentials, streams bodies, rejects routes outside the proxy API, and lets an authorization hook refuse requests or set commit attribution.",
  "request": {
    "namespace_alias": "team-files",
    "namespace_id": "conf-proxy-namespace",
    "unknown_namespace_alias": "no-such-namespace-alias",
    "actor_id": "conformance-proxy",
    "directory": "/proxy-cases",
    "proxied_path": "/proxy-cases/service-proxied.bin",
    "direct_path": "/proxy-cases/direct-put.bin",
    "commit_ids": {
      "directory": "conf-proxy-mkdir",
      "proxied": "conf-proxy-upload-proxied",
      "direct": "conf-proxy-upload-direct"
    },
    "content_utf8": "proxy conformance payload",
    "disallowed_path_suffix": "/checkpoints",
    "authorize": {
      "actor_id": "proxy-stamped-actor",
      "browser_actor_id": "browser-claimed-actor",
      "commit_id": "conf-proxy-stamped-commit",
      "directory": "/proxy-cases/stamped",
      "refuse_header": "x-loonfs-conformance-refuse",
      "refused_status": 403
    }
  },
  "expected": {
    "mkdir_committed_seq": 1,
    "proxied_committed_seq": 2,
    "direct_committed_seq": 3,
    "entry_count": 2,
    "unknown_namespace_alias_status": 404,
    "disallowed_route_status": 404,
    "stamped_committed_by": "proxy-stamped-actor",
    "stamped_committed_seq": 4,
    "refused_status": 403
  }
}
