{
  "name": "proxy",
  "intent": "A proxy forwards the routes in its route table unchanged, adds server credentials, streams bodies, rejects every other route, and lets an authorization hook refuse requests (including requests for a namespace the hook doesn't allow) or replace browser-claimed actor, subject, scope, and principal headers with the hook's.",
  "request": {
    "namespace_id": "conf-proxy-namespace",
    "actor_id": "conformance-proxy",
    "directory": "/proxy-cases",
    "proxied_path": "/proxy-cases/service-proxied.bin",
    "direct_path": "/proxy-cases/direct-put.bin",
    "commit_ids": {
      "directory": "conf-proxy-mkdir",
      "proxied": "conf-proxy-upload-proxied",
      "direct": "conf-proxy-upload-direct"
    },
    "content_utf8": "proxy conformance payload",
    "disallowed_path_suffix": "/checkpoints",
    "authorize": {
      "actor_id": "proxy-stamped-actor",
      "browser_actor_id": "browser-claimed-actor",
      "commit_id": "conf-proxy-stamped-commit",
      "directory": "/proxy-cases/stamped",
      "refuse_header": "x-loonfs-conformance-refuse",
      "refused_status": 403,
      "unlisted_namespace_id": "conf-proxy-unlisted"
    },
    "acl": {
      "namespace_id": "conf-proxy-acl",
      "principal_scope": "conformance",
      "administrator": "prn_admin",
      "member": "prn_member",
      "member_subject_id": "usr_member",
      "browser_principals": "prn_admin",
      "commit_id": "conf-proxy-acl-stamped",
      "directory": "/stamped-by-subject"
    }
  },
  "expected": {
    "mkdir_committed_seq": 1,
    "proxied_committed_seq": 2,
    "direct_committed_seq": 3,
    "entry_count": 2,
    "disallowed_route_status": 404,
    "stamped_committed_by": "proxy-stamped-actor",
    "stamped_committed_seq": 4,
    "refused_status": 403,
    "acl_stamped_committed_seq": 1,
    "acl_forbidden_status": 403,
    "routes": [
      "GET /v0/capabilities",
      "GET /v0/namespaces/{namespace_id}/changes",
      "POST /v0/namespaces/{namespace_id}/commits",
      "GET /v0/namespaces/{namespace_id}/filesystem/content",
      "POST /v0/namespaces/{namespace_id}/filesystem/downloads",
      "GET /v0/namespaces/{namespace_id}/filesystem/entries",
      "GET /v0/namespaces/{namespace_id}/filesystem/entry",
      "GET /v0/namespaces/{namespace_id}/filesystem/revisions",
      "GET /v0/namespaces/{namespace_id}/filesystem/trash",
      "GET /v0/namespaces/{namespace_id}/grep",
      "GET /v0/namespaces/{namespace_id}/snapshots",
      "POST /v0/namespaces/{namespace_id}/snapshots",
      "POST /v0/namespaces/{namespace_id}/snapshots/{snapshot_id}/extend",
      "GET /v0/namespaces/{namespace_id}/snapshots/{snapshot_id}",
      "DELETE /v0/namespaces/{namespace_id}/snapshots/{snapshot_id}",
      "POST /v0/namespaces/{namespace_id}/uploads",
      "GET /v0/namespaces/{namespace_id}/uploads/{upload_id}",
      "POST /v0/namespaces/{namespace_id}/uploads/{upload_id}/abort",
      "POST /v0/namespaces/{namespace_id}/uploads/{upload_id}/complete",
      "PUT /v0/namespaces/{namespace_id}/uploads/{upload_id}/content",
      "POST /v0/namespaces/{namespace_id}/uploads/{upload_id}/parts"
    ]
  }
}
